{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:remote": "wrangler dev",
    "dev:vite": "vite",
    "build": "vite build",
    "deploy:staging": "wrangler deploy --config wrangler.dev.toml",
    "build:jsx": "npx esbuild public/static/app.jsx public/static/landing.jsx public/static/counseling.jsx public/static/counseling_admin.jsx public/static/partner_entry.jsx public/static/partner_portal.jsx --bundle=false --loader:.jsx=jsx --outdir=public/static/compiled --target=chrome90,firefox90,safari14",
    "build:css": "npx tailwindcss -i public/static/tailwind.src.css -o public/static/tailwind.css --minify",
    "build:assets": "npm run build:jsx && npm run build:css",
    "deploy": "npm run build:assets && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000",
    "lint": "eslint public/static --ext .js,.jsx"
  },
  "dependencies": {
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@eslint/js": "^9.15.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "tailwindcss": "^3.4.19",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
